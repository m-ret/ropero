---
interface Product {
  id: number;
  titulo: string;
  talla: string;
  precio: number;
  imagen: string;
}

interface Props {
  title: string;
  products: Product[];
  id: string;
}

const { title, products, id } = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 pt-12 pb-4">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-xs tracking-widest uppercase text-warm-400">{title}</h2>
    <div class="flex gap-2">
      <button
        data-carousel-prev={id}
        class="w-8 h-8 border border-warm-300 rounded-full flex items-center justify-center text-warm-500 hover:text-warm-800 hover:border-warm-500 transition-colors cursor-pointer"
        aria-label="Anterior"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        data-carousel-next={id}
        class="w-8 h-8 border border-warm-300 rounded-full flex items-center justify-center text-warm-500 hover:text-warm-800 hover:border-warm-500 transition-colors cursor-pointer"
        aria-label="Siguiente"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
  <div
    data-carousel-track={id}
    class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide scroll-smooth"
  >
    {products.map(p => {
      const precio = new Intl.NumberFormat('es-CR').format(p.precio);
      return (
        <a href={`/producto/${p.id}`} class="shrink-0 w-40 md:w-48 snap-start group/card">
          <div class="aspect-[3/4] overflow-hidden bg-warm-100 rounded-sm">
            <img src={p.imagen} alt={p.titulo} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-105" />
          </div>
          <div class="mt-2 space-y-0.5">
            <h3 class="text-xs font-medium text-warm-800 leading-tight truncate">{p.titulo}</h3>
            <p class="text-xs text-warm-600">&#8353;{precio}</p>
            <p class="text-[10px] text-warm-400">Talla: {p.talla}</p>
          </div>
        </a>
      );
    })}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-carousel-prev]').forEach(btn => {
    const id = btn.dataset.carouselPrev!;
    const track = document.querySelector(`[data-carousel-track="${id}"]`);
    if (!track) return;
    btn.addEventListener('click', () => {
      track.scrollBy({ left: -200, behavior: 'smooth' });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-carousel-next]').forEach(btn => {
    const id = btn.dataset.carouselNext!;
    const track = document.querySelector(`[data-carousel-track="${id}"]`);
    if (!track) return;
    btn.addEventListener('click', () => {
      track.scrollBy({ left: 200, behavior: 'smooth' });
    });
  });
</script>
