---
interface Props {
  id: number;
  titulo: string;
  descripcion: string;
  talla: string;
  precio: number;
  imagen: string;
  vendido: boolean;
}

const { id, titulo, descripcion, talla, precio, imagen, vendido } = Astro.props;

const precioFormateado = new Intl.NumberFormat('es-CR').format(precio);
---

<a href={`/producto/${id}`} class:list={["group block", { "opacity-50 pointer-events-none": vendido }]}>
  <article class="relative">
    <div class="aspect-[3/4] overflow-hidden bg-warm-100 rounded-sm">
      <img
        src={imagen}
        alt={titulo}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      {vendido && (
        <div class="absolute inset-0 flex items-center justify-center bg-warm-50/70">
          <span class="text-warm-700 font-medium tracking-widest uppercase text-sm">Vendido</span>
        </div>
      )}
    </div>
    <div class="mt-3 space-y-1">
      <div class="flex items-start justify-between gap-2">
        <h3 class="text-sm font-medium text-warm-800 leading-tight">{titulo}</h3>
        <span class="text-sm font-medium text-warm-700 shrink-0">&#8353;{precioFormateado}</span>
      </div>
      <p class="text-xs text-warm-500 leading-relaxed line-clamp-2">{descripcion}</p>
      <div class="flex items-center justify-between pt-1">
        <span class="text-xs text-warm-400 tracking-wide">Talla: {talla}</span>
        <span class="text-xs font-medium text-warm-600 group-hover:text-warm-900 transition-colors tracking-wide uppercase">
          Ver detalle
        </span>
      </div>
    </div>
  </article>
</a>
