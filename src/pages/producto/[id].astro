---
import Layout from '../../layouts/Layout.astro';
import HorizontalCarousel from '../../components/HorizontalCarousel.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map(product => ({
    params: { id: String(product.id) },
    props: { product },
  }));
}

const { product } = Astro.props;

const precioFormateado = new Intl.NumberFormat('es-CR').format(product.precio);
const mensaje = encodeURIComponent(
  `Hola! Me interesa: "${product.titulo}" (Talla: ${product.talla}) - ₡${precioFormateado}. ¿Está disponible?`
);
// TODO: Cambiar este número por el de tu esposa
const whatsappUrl = `https://wa.me/50600000000?text=${mensaje}`;

// Poster first, then additional images
const allImages = [product.imagen, ...product.imagenes];
const hasMultipleImages = allImages.length > 1;

const categoriaLabel: Record<string, string> = {
  tops: 'Tops',
  bottoms: 'Bottoms',
  zapatos: 'Zapatos',
  accesorios: 'Accesorios',
};

const generoLabel = product.genero === 'mujer' ? 'Mujer' : 'Hombre';
const backUrl = product.genero === 'mujer' ? '/mujer' : '/hombre';

// Related products: same gender, not sold, not current, shuffled
const related = products
  .filter(p => p.genero === product.genero && p.id !== product.id && !p.vendido)
  .sort(() => Math.random() - 0.5)
  .slice(0, 8);

// More from same category
const sameCategory = products
  .filter(p => p.categoria === product.categoria && p.id !== product.id && !p.vendido && !related.find(r => r.id === p.id))
  .sort(() => Math.random() - 0.5)
  .slice(0, 8);
---

<Layout title={`${product.titulo} - Ropero`}>
  <section class="max-w-5xl mx-auto px-4 py-8">
    <a href={backUrl} class="text-xs text-warm-400 hover:text-warm-600 transition-colors tracking-wide inline-block mb-6">
      &larr; Volver a {generoLabel}
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
      <!-- Image carousel -->
      <div class="space-y-3">
        <div class="aspect-[3/4] overflow-hidden bg-warm-100 rounded-sm relative" id="main-image-container">
          <img
            id="main-image"
            src={allImages[0]}
            alt={product.titulo}
            class="w-full h-full object-cover"
          />
          {product.vendido && (
            <div class="absolute inset-0 flex items-center justify-center bg-warm-50/70">
              <span class="text-warm-700 font-medium tracking-widest uppercase">Vendido</span>
            </div>
          )}
          {hasMultipleImages && (
            <>
              <button
                id="prev-btn"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 bg-white/80 hover:bg-white rounded-full flex items-center justify-center text-warm-700 transition-colors cursor-pointer"
                aria-label="Imagen anterior"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                id="next-btn"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 bg-white/80 hover:bg-white rounded-full flex items-center justify-center text-warm-700 transition-colors cursor-pointer"
                aria-label="Siguiente imagen"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </>
          )}
        </div>

        {hasMultipleImages && (
          <div class="flex gap-2 overflow-x-auto pb-1" id="thumbnails">
            {allImages.map((img, i) => (
              <button
                data-index={i}
                class:list={[
                  "shrink-0 w-16 h-20 overflow-hidden rounded-sm border-2 transition-colors cursor-pointer thumbnail-btn",
                  i === 0 ? "border-warm-700" : "border-transparent hover:border-warm-300"
                ]}
              >
                <img src={img} alt={`${product.titulo} - foto ${i + 1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}

        {!hasMultipleImages && (
          <p class="text-xs text-warm-300 italic">Solo una foto disponible</p>
        )}
      </div>

      <!-- Product details -->
      <div class="flex flex-col justify-center space-y-6">
        <div class="space-y-2">
          <div class="flex gap-2 text-xs text-warm-400 tracking-widest uppercase">
            <span>{generoLabel}</span>
            <span>/</span>
            <span>{categoriaLabel[product.categoria]}</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-light text-warm-800 tracking-wide">{product.titulo}</h1>
          <p class="text-2xl font-light text-warm-700">&#8353;{precioFormateado}</p>
        </div>

        <div class="space-y-3">
          <p class="text-sm text-warm-600 leading-relaxed">{product.descripcion}</p>
          <div class="flex items-center gap-4 text-sm text-warm-500">
            <span class="px-3 py-1 border border-warm-200 rounded-sm">Talla: {product.talla}</span>
          </div>
        </div>

        {!product.vendido ? (
          <div class="space-y-3 pt-2">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center px-6 py-3 bg-warm-800 text-warm-50 text-sm tracking-widest uppercase hover:bg-warm-700 transition-colors rounded-sm"
            >
              Consultar por WhatsApp
            </a>
            <p class="text-xs text-warm-400 text-center">
              Pago por SINPE Movil &middot; Envio: &#8353;3,000
            </p>
          </div>
        ) : (
          <div class="px-6 py-3 border border-warm-300 text-center text-sm text-warm-500 tracking-widest uppercase rounded-sm">
            Este articulo ya fue vendido
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Related products -->
  {related.length > 0 && (
    <HorizontalCarousel title="Tambien te puede interesar" products={related} id="related" />
  )}

  {sameCategory.length > 0 && (
    <HorizontalCarousel title={`Mas en ${categoriaLabel[product.categoria]}`} products={sameCategory} id="category" />
  )}
</Layout>

<script define:vars={{ allImages }}>
  if (allImages.length > 1) {
    let current = 0;
    const mainImg = document.getElementById('main-image');
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    function goTo(index) {
      current = (index + allImages.length) % allImages.length;
      mainImg.src = allImages[current];
      thumbnails.forEach((thumb, i) => {
        if (i === current) {
          thumb.classList.add('border-warm-700');
          thumb.classList.remove('border-transparent');
        } else {
          thumb.classList.remove('border-warm-700');
          thumb.classList.add('border-transparent');
        }
      });
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));
    thumbnails.forEach((thumb, i) => {
      thumb.addEventListener('click', () => goTo(i));
    });
  }
</script>
