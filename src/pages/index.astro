---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import products from '../data/products.json';

const available = products.filter(p => !p.vendido);
const sold = products.filter(p => p.vendido);
const allProducts = [...available, ...sold];
---

<Layout>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-16 space-y-3">
      <h1 class="text-4xl font-light tracking-widest uppercase text-warm-800">Ropero</h1>
      <p class="text-sm text-warm-500 max-w-md mx-auto leading-relaxed">
        Ropa, zapatos y accesorios de segunda mano con mucha vida por dar. Piezas unicas para hombre y mujer.
      </p>
      <div class="flex justify-center gap-4 pt-4 text-xs tracking-widest uppercase">
        <a href="/mujer" class="px-4 py-2 border border-warm-300 text-warm-700 hover:bg-warm-100 transition-colors rounded-sm">
          Mujer
        </a>
        <a href="/hombre" class="px-4 py-2 border border-warm-300 text-warm-700 hover:bg-warm-100 transition-colors rounded-sm">
          Hombre
        </a>
      </div>
    </div>

    <h2 class="text-xs tracking-widest uppercase text-warm-400 mb-6">Todos los articulos ({available.length} disponibles)</h2>
    <ProductGrid products={allProducts} />
  </section>
</Layout>
