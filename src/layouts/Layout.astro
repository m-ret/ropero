---
import '../styles/global.css'

interface Props {
  title?: string;
}

const { title = 'Ropero - Ropa de Segunda Mano' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ropero - Tienda de ropa, zapatos y accesorios de segunda mano. Piezas únicas para hombre y mujer." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <header class="border-b border-warm-200">
      <nav class="max-w-6xl mx-auto px-4 py-6 flex items-center justify-between">
        <a href="/" class="text-2xl font-light tracking-widest uppercase text-warm-800 hover:text-warm-600 transition-colors">
          Ropero
        </a>
        <div class="flex gap-6 text-sm tracking-wide text-warm-600">
          <a href="/" class="hover:text-warm-900 transition-colors">Inicio</a>
          <a href="/mujer" class="hover:text-warm-900 transition-colors">Mujer</a>
          <a href="/hombre" class="hover:text-warm-900 transition-colors">Hombre</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-warm-200 mt-20">
      <div class="max-w-6xl mx-auto px-4 py-10 text-center text-sm text-warm-500 space-y-3">
        <p class="font-medium text-warm-700">Pago por SINPE Movil</p>
        <p>Envio a todo el pais: <span class="font-medium text-warm-700">&#8353;3,000</span></p>
        <p class="pt-2">&copy; {new Date().getFullYear()} Ropero. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
